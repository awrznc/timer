{
  "name": "dev-container",
  "image": "oven/bun:1.4.4",
  "postStartCommand": "bun run --hot ./src/index.html ./src/help.html",
  "forwardPorts": [
    3000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
